{
  "name": "relateurl",
  "description": "Create a relative URL with minify options.",
  "version": "1.0.0-alpha",
  "license": "MIT",
  "author": "Steven Vachon <contact@svachon.com> (https://www.svachon.com/)",
  "main": "lib/relateurl",
  "repository": "stevenvachon/relateurl",
  "dependencies": {
    "cloneurl": "^1.0.0-alpha3",
    "deep-freeze-node": "^1.1.2",
    "evaluate-value": "^1.0.2",
    "isurl": "^1.0.0-alpha5",
    "minurl": "^1.0.0-alpha13",
    "url-relation": "^1.0.0-alpha9"
  },
  "devDependencies": {
    "babelify": "^7.3.0",
    "babel-cli": "^6.24.1",
    "babel-preset-es2015": "^6.24.1",
    "browserify": "^14.4.0",
    "chai": "^4.0.1",
    "coveralls": "^2.13.1",
    "gzip-size-cli": "^2.0.0",
    "mocha": "^3.4.2",
    "npm-watch": "~0.2.0",
    "nyc": "^11.0.2",
    "uglify-js": "^3.0.15",
    "universal-url": "^1.0.0-alpha"
  },
  "engines": {
    "node": ">= 4"
  },
  "scripts": {
    "ci": "npm run test && nyc report --reporter=text-lcov | coveralls",
    "posttest": "nyc report --reporter=html && browserify lib/relateurl --global-transform [ babelify --presets [ es2015 ] ] --standalone relateURL | uglifyjs --compress --mangle | gzip-size",
    "pretest": "babel src --out-dir=lib --presets=es2015 --source-maps=true",
    "test": "nyc --reporter=text-summary mocha test/ --reporter=spec --check-leaks --bail",
    "watch": "npm-watch test"
  },
  "watch": {
    "test": {
      "inherit": true,
      "patterns": "{src,test}/**/*.{js,json}"
    }
  },
  "files": ["lib/relateurl.js"],
  "keywords": [
    "absolute",
    "minifier",
    "minify",
    "normalize",
    "relative",
    "uri",
    "url",
    "whatwg"
  ]
}
