{
  "name": "relateurl",
  "description": "Create a relative URL with minify options.",
  "version": "1.0.0-alpha",
  "license": "MIT",
  "author": "Steven Vachon <contact@svachon.com> (https://www.svachon.com/)",
  "repository": "stevenvachon/relateurl",
  "dependencies": {
    "cloneurl": "^2.0.0",
    "deep-freeze-node": "^1.1.3",
    "evaluate-value": "^1.0.2",
    "isurl": "^2.0.0",
    "minurl": "github:stevenvachon/minurl",
    "url-relation": "github:stevenvachon/url-relation"
  },
  "devDependencies": {
    "@babel/core": "^7.2.0",
    "@babel/preset-env": "^7.2.0",
    "babelify": "^10.0.0",
    "browserify": "^16.2.3",
    "chai": "^4.2.0",
    "coveralls": "^3.0.2",
    "gzip-size-cli": "^3.0.0",
    "incomplete-url": "^3.0.0",
    "mocha": "^5.2.0",
    "npm-watch": "~0.5.0",
    "nyc": "^13.1.0",
    "terser": "^3.11.0",
    "universal-url": "^2.0.0"
  },
  "engines": {
    "node": ">= 8"
  },
  "scripts": {
    "ci": "npm run test && nyc report --reporter=text-lcov | coveralls",
    "posttest": "nyc report --reporter=html && browserify index.js --global-transform [ babelify --presets [ @babel/env ] ] --standalone relateURL | terser --compress --mangle | gzip-size",
    "test": "nyc --reporter=text-summary mocha test --check-leaks --bail",
    "watch": "npm-watch test"
  },
  "watch": {
    "test": {
      "inherit": true,
      "patterns": [
        "helpers",
        "index.js",
        "test.js"
      ]
    }
  },
  "files": [
    "index.js"
  ],
  "keywords": [
    "absolute",
    "minifier",
    "minify",
    "normalize",
    "relative",
    "uri",
    "url",
    "whatwg"
  ]
}
